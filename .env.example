# Copy this file to ".env" and fill in ONE key. Never commit ".env".

# Option A - Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Option B - Claude (paid credits required): https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# Optional: force a provider ("gemini" or "anthropic"). Default: whichever key is set.
# LLM_PROVIDER=gemini

# Other settings (defaults shown)
MAX_RESULT_ROWS=1000
QUERY_TIMEOUT_SECONDS=10
MAX_UPLOAD_MB=50
